# Credentials stay outside version control; this sample is safe to track
.env
.env.*
*.pem
*.key

# New build snapshots are reproducible; already tracked deliveries stay tracked
/????-??-??/dist/
/dist/

# Interrupted atomic queue writes, not durable queue/artifact records
/????-??-??/editorial-artifacts/_queue.json.tmp.*

# Scratch work has an explicit home; historical evidence remains visible
.scratch/
*.log

# Local Issue Artifact compiles (make tracer defaults to /tmp)
/wsj-*.html
/blobs/
