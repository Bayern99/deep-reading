   },
   {
    "en": "Common Cause",
    "zh_suggested": "Common Cause（倡导组织）",
    "note": "待查"
   },
   {
    "en": "MAGA Inc.",
    "zh_suggested": "MAGA Inc.（超级政治行动委员会）"
   },
