# Keep textual source portable without normalizing existing history.
*.py text eol=lf
*.md text eol=lf
internal/testdata/markdown/17-crlf.md -text
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary

# Source releases use the explicit package allowlist. Git source archives also
# exclude local automation and evidence locations if accidentally tracked.
.scratch export-ignore
workspaces export-ignore
issues export-ignore
dist export-ignore
blobs export-ignore
